# Runtime connection: a NON-owner role that is a member of mrc_app, so Postgres RLS applies.
DATABASE_URL=postgresql://mrc_app:CHANGE_ME@localhost:5432/mrc
# Owner role used only for migrations and seeding.
MIGRATE_DATABASE_URL=postgresql://mrc:CHANGE_ME@localhost:5432/mrc
APP_URL=http://localhost:3280
API_PORT=3281
API_HOST=127.0.0.1
REDIS_URL=redis://127.0.0.1:6379
STORAGE_DIR=./storage
# 32 bytes, base64 or hex. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=24
ENFORCE_ADMIN_MFA=false
ALLOW_SIGNUP=true
LOGIN_MAX_FAILURES=8
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_PER_MIN=300
AUTH_RATE_LIMIT_MULTIPLIER=1
MFA_ISSUER=Music Rights Cloud
# Seed (synthetic demo data only)
SEED_ADMIN_EMAIL=intubemediaofficial@gmail.com
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
